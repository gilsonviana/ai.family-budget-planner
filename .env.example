# SQLite database location (relative paths resolve from the directory where finance runs).
FINANCE_DATABASE_PATH=./data/finance.sqlite

# Required only for `finance insight --llm`. Keep real credentials only in your untracked .env file.
FINANCE_LLM_PROVIDER=openai
FINANCE_LLM_MODEL=gpt-5-mini
FINANCE_LLM_API_KEY=replace-with-your-openai-api-key

# Optional: required only for `finance reminder:process`.
# FINANCE_EMAIL_PROVIDER=resend
# FINANCE_EMAIL_FROM=Family Finance <finance@example.com>
# FINANCE_EMAIL_API_KEY=replace-with-your-resend-api-key
